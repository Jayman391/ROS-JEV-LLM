<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>jev_ai_cpp</name>
  <version>0.1.0</version>
  <description>jev_ai C++ clients: DecisionClient (decide_server), JevClient, ReasonClient, and a component example</description>
  <maintainer email="jasonlobell123@gmail.com">Jason Lobell</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>rclcpp_components</depend>
  <depend>diagnostic_msgs</depend>
  <depend>jev_ai_msgs</depend>

  <exec_depend>jev_ai_servers</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
