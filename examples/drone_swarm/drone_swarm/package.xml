<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>drone_swarm</name>
  <version>0.1.0</version>
  <description>Drone swarm reference example (Part B): search &amp; rescue with jev_ai agents (drone_agent, mission_coordinator), the world (environment, mission_scorer, world generator) and the Gazebo launch.</description>
  <maintainer email="jasonlobell123@gmail.com">Jason Lobell</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>jev_ai</exec_depend>
  <exec_depend>jev_ai_msgs</exec_depend>
  <exec_depend>jev_ai_servers</exec_depend>
  <exec_depend>jev_ai_bringup</exec_depend>
  <exec_depend>swarm_interfaces</exec_depend>
  <exec_depend>swarm_control</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>diagnostic_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
