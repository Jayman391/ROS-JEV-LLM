Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Line
      Namespaces:
        line: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
        Value: /line/markers
      Value: true
  Enabled: true
  Global Options:
    Background Color: 30; 30; 36
    Fixed Frame: line
    Frame Rate: 15
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 16
      Focal Point:
        X: 7.5
        Y: 0
        Z: 0
      Pitch: 0.75
      Yaw: 4.71
      Name: Current View
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz)
    Saved: ~
Window Geometry:
  Height: 800
  Width: 1280
