<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>line_gz</name>
  <version>0.1.0</version>
  <description>Assembly line example: line_gz, the Gazebo Fortress puppet view (pallets and arms mirror line_sim; display only). Builds to nothing without Gazebo.</description>
  <maintainer email="jasonlobell123@gmail.com">Jason Lobell</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>visualization_msgs</depend>
  <depend>line_interfaces</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
